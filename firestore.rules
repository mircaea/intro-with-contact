rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }
    
    // Settings - public read, admin write
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Pages - public read, admin write
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Services - public read, admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Pricing - public read, admin write
    match /pricing/{pricingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Bookings - public create, admin read/write
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Contact submissions - public create, admin read/write
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
