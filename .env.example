# ===========================================
# Environment Variables Template
# ===========================================
# Copy this file to .env.local and fill in values
# cp .env.example .env.local
# ===========================================

# -------------------------------------------
# Firebase Client SDK (Public - safe to expose)
# -------------------------------------------
# Get from: Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -------------------------------------------
# Firebase Admin SDK (Server-side - KEEP SECRET)
# -------------------------------------------
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Extract values from downloaded JSON file
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# -------------------------------------------
# SendGrid (Email Service)
# -------------------------------------------
# Get from: SendGrid Dashboard → Settings → API Keys → Create API Key
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Admin email for receiving notifications
ADMIN_EMAIL=

# -------------------------------------------
# Google Calendar API (Booking System)
# -------------------------------------------
# Step 1: Enable Google Calendar API in Google Cloud Console
# Step 2: Create OAuth credentials (APIs & Services → Credentials)
# Step 3: Get refresh token via OAuth Playground
# Step 4: Get Calendar ID from Google Calendar settings
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# -------------------------------------------
# Site URL (for emails and links)
# -------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
